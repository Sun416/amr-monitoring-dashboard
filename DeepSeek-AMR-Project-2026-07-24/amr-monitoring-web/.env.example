# Web server. Keep 127.0.0.1 until authentication is added.
WEB_HOST=127.0.0.1
WEB_PORT=3080

# SQL Server connection. Use a dedicated least-privilege SQL login.
DB_SERVER=localhost
# Leave DB_INSTANCE empty for a default instance. Example: SQLEXPRESS
DB_INSTANCE=
DB_PORT=1433
DB_DATABASE=IOT2020
DB_USER=amr_monitor_web
DB_PASSWORD=replace_with_password
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
DB_USE_UTC=false
DB_CONNECTION_TIMEOUT_MS=15000
DB_REQUEST_TIMEOUT_MS=120000

# Dashboard display settings.
DASHBOARD_STALE_MINUTES=5
ONLINE_ANCHOR_MINUTES=5
